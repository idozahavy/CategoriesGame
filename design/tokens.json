{
  "$schema": "./tokens.schema.json",
  "$description": "CategoriesGame design tokens — single source of truth. Candy Pop direction, C2 teal-lead palette. Semantic tokens reference primitives; every raw value appears exactly once.",
  "version": "0.1.0",
  "color": {
    "primitive": {
      "cream-50": { "$type": "color", "$value": "#FFF8F0" },
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "sand-200": { "$type": "color", "$value": "#F3E7DA" },
      "sand-300": { "$type": "color", "$value": "#D9C8B8" },
      "brown-600": { "$type": "color", "$value": "#7A6E71" },
      "brown-900": { "$type": "color", "$value": "#3D3436" },
      "teal-600": { "$type": "color", "$value": "#0E7C72" },
      "teal-800": { "$type": "color", "$value": "#084F48" },
      "pink-600": { "$type": "color", "$value": "#C61E72" },
      "pink-800": { "$type": "color", "$value": "#8F1252" },
      "orange-400": { "$type": "color", "$value": "#FF9A3D" },
      "orange-900": { "$type": "color", "$value": "#4A2800" },
      "green-700": { "$type": "color", "$value": "#227A2C" },
      "red-700": { "$type": "color", "$value": "#C22328" },
      "red-900": { "$type": "color", "$value": "#8F181C" },
      "grape-600": { "$type": "color", "$value": "#6D41E0" },
      "grape-800": { "$type": "color", "$value": "#4C27AA" },
      "amber-700": { "$type": "color", "$value": "#B45309" },
      "blue-700": { "$type": "color", "$value": "#1D4ED8" },
      "pink-700": { "$type": "color", "$value": "#BE185D" },
      "stone-600": { "$type": "color", "$value": "#57534E" }
    },
    "light": {
      "bg": { "$type": "color", "$value": "{color.primitive.cream-50}" },
      "surface": { "$type": "color", "$value": "{color.primitive.white}" },
      "text": { "$type": "color", "$value": "{color.primitive.brown-900}" },
      "muted": { "$type": "color", "$value": "{color.primitive.brown-600}" },
      "border": { "$type": "color", "$value": "{color.primitive.sand-200}" },
      "border-strong": { "$type": "color", "$value": "{color.primitive.sand-300}" },
      "primary": { "$type": "color", "$value": "{color.primitive.teal-600}" },
      "primary-edge": { "$type": "color", "$value": "{color.primitive.teal-800}" },
      "on-primary": { "$type": "color", "$value": "{color.primitive.white}" },
      "accent": { "$type": "color", "$value": "{color.primitive.pink-600}" },
      "accent-edge": { "$type": "color", "$value": "{color.primitive.pink-800}" },
      "on-accent": { "$type": "color", "$value": "{color.primitive.white}" },
      "warning": { "$type": "color", "$value": "{color.primitive.orange-400}" },
      "on-warning": { "$type": "color", "$value": "{color.primitive.orange-900}" },
      "success": { "$type": "color", "$value": "{color.primitive.green-700}" },
      "on-success": { "$type": "color", "$value": "{color.primitive.white}" },
      "danger": { "$type": "color", "$value": "{color.primitive.red-700}" },
      "danger-edge": { "$type": "color", "$value": "{color.primitive.red-900}" },
      "on-danger": { "$type": "color", "$value": "{color.primitive.white}" },
      "focus": { "$type": "color", "$value": "{color.primitive.grape-600}" },
      "player-1": { "$type": "color", "$value": "{color.primitive.teal-600}" },
      "player-2": { "$type": "color", "$value": "{color.primitive.pink-600}" },
      "player-3": { "$type": "color", "$value": "{color.primitive.amber-700}" },
      "player-4": { "$type": "color", "$value": "{color.primitive.grape-600}" },
      "player-5": { "$type": "color", "$value": "{color.primitive.blue-700}" },
      "player-6": { "$type": "color", "$value": "{color.primitive.green-700}" },
      "player-7": { "$type": "color", "$value": "{color.primitive.pink-700}" },
      "player-8": { "$type": "color", "$value": "{color.primitive.stone-600}" }
    }
  },
  "typography": {
    "family": {
      "base": { "$type": "fontFamily", "$value": ["Nunito", "Varela Round", "Segoe UI", "system-ui", "sans-serif"], "$description": "Self-hosted Nunito (latin+cyrillic+hebrew subsets); never load from external URL." }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "40px" },
      "h1": { "$type": "dimension", "$value": "28px" },
      "h2": { "$type": "dimension", "$value": "22px" },
      "body": { "$type": "dimension", "$value": "17px" },
      "small": { "$type": "dimension", "$value": "14px" }
    },
    "weight": {
      "display": { "$type": "fontWeight", "$value": 800 },
      "heading": { "$type": "fontWeight", "$value": 800 },
      "subheading": { "$type": "fontWeight", "$value": 700 },
      "body": { "$type": "fontWeight", "$value": 600 }
    },
    "lineHeight": {
      "display": { "$type": "number", "$value": 1.15 },
      "h1": { "$type": "number", "$value": 1.2 },
      "h2": { "$type": "number", "$value": 1.3 },
      "body": { "$type": "number", "$value": 1.5 },
      "small": { "$type": "number", "$value": 1.4 }
    },
    "numeric": {
      "scores": { "$type": "fontFeature", "$value": "tabular-nums", "$description": "Scores and timers always use tabular figures." }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px", "$description": "Buttons, inputs" },
    "lg": { "$type": "dimension", "$value": "24px", "$description": "Cards, panels" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Chips, timer pill" }
  },
  "border": {
    "width": { "$type": "dimension", "$value": "2px" },
    "edge-width": { "$type": "dimension", "$value": "5px", "$description": "Pressable button bottom edge" }
  },
  "shadow": {
    "card": { "$type": "shadow", "$value": { "offsetX": "0", "offsetY": "4px", "blur": "12px", "color": "rgba(61,52,54,0.10)" } }
  },
  "z": {
    "base": { "$type": "number", "$value": 0 },
    "sticky": { "$type": "number", "$value": 10 },
    "overlay": { "$type": "number", "$value": 100 },
    "modal": { "$type": "number", "$value": 110 },
    "toast": { "$type": "number", "$value": 120 }
  }
}
